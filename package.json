          "type": "string",
          "default": "",
          "description": "uni-app自动化测试依赖：自定义依赖目录。1. 配置方法：插件hbuilderv-for-uniapp-test/src/environment目录下 2. 拷贝package.json到你要自定义的目录，执行npm install。3. 注意：请谨慎操作。路径必须要以node_modules结尾。如非专业人员，建议使用默认，不要修改此项。"
        },
        "uniapp-test-cfg.storageTestReportOutPutDirType": {
          "type": "string",
          "default": "项目目录",
          "enum": [
            "项目目录",
            "其它"
          ],
          "description": "uni-app自动化测试插件，测试报告，存储类型。"
        },
        "uniapp-test-cfg.testReportOutPutDir": {
          "type": "string",
          "default": "",
          "description": "uni-app自动化测试插件，测试报告输出路径。当测试报告存储类型，选择 [其它] 时生效。",
          "when": "iSOtherTestReport"
        },
        "uniapp-test-cfg.AutomaticModificationTestMatch": {
          "type": "boolean",
          "default": true,
          "description": "自动修改jest.config.js文件中的testMatch。默认规范：测试用例在pages页面目录下。如测试用例在其它目录，请不要勾选此项。"
        },
        "uniapp-test-cfg.jestNodeType": {
          "type": "boolean",
          "default": true,
          "description": "自动化测试时，使用编辑器内置的Node运行Jest测试程序。"
        },
        "uniapp-test-cfg.uniappCompileNodeType": {
          "type": "boolean",
          "default": true,
          "description": "自动化测试时，使用编辑器内置的Node程序编译uni-app项目。"
        },
        "uniapp-test-cfg.recordTestCaseList": {
          "type": "boolean",
          "default": false,
          "description": "当运行单条test.js用例文件，记录测试用例文件路径到.hbuilderx目录下。"
        },
        "uniapp-test-cfg.isDebug": {
          "type": "boolean",
          "default": false,
          "description": "是否正在调试，当勾选后，将会在控制台输出更多日志。"
        },
        "uniapp-test-cfg.isRuntimeLog": {
          "type": "boolean",
          "default": true,
          "description": "是否输出运行时日志。"
        }
      }
    },
    "keybindings": [
      {
        "command": "unitest.createTestCase",
        "key": "Ctrl + Shift + C",
        "when": "expression.isShowCreateTestCase",
        "macosx": "command+Shift+C"
      }
    ],
    "submenus": [
      {
        "id": "unitest",
        "label": "uni-app 运行自动化测试(&R)"
      },
      {
        "id": "unitestForCurrent",
        "label": "uni-app 运行当前测试用例"
      },
      {
        "id": "unitestRun",
        "label": "uni-app自动化测试辅助插件"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "unitest.initialization",
          "group": "openInExplorer",
          "when": "explorerResourceCount == 1 && expression.isUniApp && !expression.isCheckTestEnv  && explorerResourceIsWorkspaceFolder"
        },
        {
          "command": "unitest.createTestCase",
          "group": "new",
          "when": "resourceFilename =~ /^pages$/i || resourcePath =~ /[\\\\/]pages[\\\\/][^\\\\/]+$/i || resourceFilename =~ /\\.(vue|nvue)$/i"
        },
        {
          "submenu": "unitest",
          "group": "openInExplorer",
          "when": "!resourceScheme || resourceFilename =~ /^pages$/i || resourcePath =~ /[\\\\/]pages$/i"
        },
        {
          "command": "unitest.addFilePathToJestConfig",
          "group": "openInExplorer",
          "when": "explorerResourceCount == 1 && expression.isShowRunCurrentTestCaseMenu"
        },
        {
          "submenu": "unitestForCurrent",
          "group": "openInExplorer",
          "when": "resourceFilename =~ /\\.test\\.js$/i || workspaceFolderRelativePath =~ /\\.test\\.js$/i || resourcePath =~ /\\.test\\.js$/i"
        }
      ],
      "editor/context": [
        {
          "command": "unitest.addFilePathToJestConfig",
          "group": "copy",
          "when": "expression.isShowRunCurrentTestCaseMenu"
        },
        {
          "submenu": "unitestForCurrent",
          "group": "copy",
          "when": "resourceFilename =~ /\\.test\\.js$/i || workspaceFolderRelativePath =~ /\\.test\\.js$/i || resourcePath =~ /\\.test\\.js$/i"
        }
      ],
      "menubar/run": [
        {
          "submenu": "unitestRun",
          "group": "0_foot"
        }
      ],
      "unitest": [
        {
          "command": "unitest.runTestAndroid",
          "title": "Android(&A)",
          "group": "unitest@1"
        },
        {
          "command": "unitest.runTestIOS",
          "title": "iOS(&I)",
          "when": "isMac",
          "group": "unitest@2"
        },
        {
          "command": "unitest.runTestHarmony",
          "title": "Harmony(&A)",
          "group": "unitest@1"
        },
        {
          "command": "unitest.runTestWeiXin",
          "title": "微信小程序(&M)",
          "group": "unitest@3"
        },
        {
          "command": "unitest.runTestAlipay",
          "title": "支付宝小程序(&P)",
          "group": "unitest@3"
        },
        {
          "command": "unitest.runTestH5",
          "title": "Web-Chrome(&H)",
          "group": "unitest@4"
        },
        {
          "command": "unitest.runTestH5Firefox",
          "title": "Web-Firefox(&H)",
          "group": "unitest@5"
        },
        {
          "command": "unitest.runTestH5Safari",
          "title": "Web-Safari(&H)",
          "group": "unitest@6",
          "when": "isMac"
        }
      ],
      "unitestForCurrent": [
        {
          "command": "unitest.runCurrentTestAndroid",
          "title": "Android(&A)",
          "group": "unitestForCurrent@1"
        },
        {
          "command": "unitest.runCurrentTestIOS",
          "title": "iOS(&I)",
          "when": "isMac",
          "group": "unitestForCurrent@2"
        },
        {
          "command": "unitest.runCurrentTestHarmony",
          "title": "Harmony(&A)",
          "group": "unitestForCurrent@3"
        },
        {
          "command": "unitest.runCurrentTestWeiXin",
          "title": "微信小程序(&M)",
          "group": "unitestForCurrent@3"
        },
        {
          "command": "unitest.runCurrentTestAlipay",
          "title": "支付宝小程序(&P)",
          "group": "unitestForCurrent@3"
        },
        {
          "command": "unitest.runCurrentTestH5",
          "title": "Web-Chrome(&H)",
          "group": "unitestForCurrent@4"
        },
        {
          "command": "unitest.runCurrentTestH5Firefox",
          "title": "Web-Firefox(&H)",
          "group": "unitestForCurrent@4"
        },
        {
          "command": "unitest.runCurrentTestH5Safari",
          "title": "Web-Safari(&H)",
          "group": "unitestForCurrent@4",
          "when": "isMac"
        }
      ],
      "unitestRun": [
        {
          "command": "unitest.isAutotestMatch",
          "checked": "expression.isAutoTestMatch",
          "group": "unitest@1"
        },
        {
          "command": "unitest.enableDebugLog",
          "checked": "expression.isDebugLog",
          "group": "unitest@1"
        },
        {
          "command": "unitest.enableRuntimeLog",
          "checked": "expression.isRuntimeLog",
          "group": "unitest@1"
        },
        {
          "command": "unitest.moreSettings",
          "group": "unitest@1"
        },
        {
          "command": "unitest.recordTestCaseList",
          "checked": "expression.isRecordTestCaseList",
          "group": "unitest@1"
        },
        {
          "command": "unitest.createAgentsMd",
          "group": "unitest@1"
        },
        {
          "command": "unitest.reloadEnv",
          "title": "重装测试环境依赖",
          "group": "unitest@3"
        }
      ]
    }
  },
  "keywords": [
    "uni-app,test,自动化测试"
  ],
  "extensionDependencies": [
    "dcloud.hbuilderx-uniapp-features"
  ],
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.15",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.40",
    "typescript": "^5.5.4",
    "vite": "^8.1.5",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.8"
  },
  "dependencies": {
    "@vscode/vsce": "^4.0.0",
    "jsonc-parser": "^3.3.1",
    "markdown-it": "^14.3.0",
    "monaco-editor": "^0.56.0",
    "adm-zip": "^0.5.17"
  }
}
